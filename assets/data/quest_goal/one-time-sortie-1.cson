206: #「水雷戦隊」で出撃せよ！ (B6)
  # 出撃にはpoi側で編成情報がないため、最初の戦闘で数える
  # 駆逐艦は「複数」（2隻以上）として判定
  "battle":
    description: "作戦"
    flagshiptype: [3] #軽巡洋艦
    escortshiptype: [
      [[2], 2] #駆逐艦
    ]
    required: 1
    init: 0
